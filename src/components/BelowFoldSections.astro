---
import { useTranslations, getLocalizedPath, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const homeUrl = getLocalizedPath(lang, '');
---

<div class="mx-auto max-w-6xl space-y-16 px-4 py-14 sm:px-6 lg:px-8">
  <!-- 3-Tier Visual Breadcrumb Navigation (Maps 1:1 to JSON-LD BreadcrumbList) -->
  <nav
    aria-label="Breadcrumb"
    class="inline-flex flex-wrap items-center gap-2 rounded-2xl border-2 border-[#31AAA9] bg-[var(--workspace-box-bg)] px-4 py-2 text-sm font-bold shadow-sm"
  >
    <a href={homeUrl} class="text-[#31AAA9] hover:underline">
      {t.breadcrumbHome}
    </a>
    <span class="text-[var(--text-secondary)]" aria-hidden="true">&gt;</span>
    <a href={`${homeUrl}#converter-hero`} class="text-[#31AAA9] hover:underline">
      {t.breadcrumbCategory}
    </a>
    <span class="text-[var(--text-secondary)]" aria-hidden="true">&gt;</span>
    <span class="text-[var(--text-primary)]" aria-current="page">
      {t.breadcrumbTool}
    </span>
  </nav>

  <!-- Step-by-Step HowTo Section (Maps 1:1 to JSON-LD HowTo Schema) -->
  <section aria-labelledby="howto-heading" class="rounded-3xl border-2 border-[#31AAA9] bg-[var(--workspace-box-bg)] p-6 shadow-sm sm:p-10">
    <div class="mb-8 text-center">
      <h2
        id="howto-heading"
        class="font-display text-3xl font-extrabold text-[var(--text-primary)] sm:text-4xl"
      >
        {t.howToTitle}
      </h2>
      <p class="mt-2 text-lg font-medium text-[var(--text-secondary)]">
        {t.howToSubtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="rounded-2xl border-2 border-[#31AAA9] bg-[var(--bg-primary)] p-6">
        <div class="mb-3 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-[#A82020] font-display text-xl font-extrabold text-[#FFFFFF]">
          01
        </div>
        <h3 class="font-display text-xl font-extrabold text-[var(--text-primary)]">
          {t.howToStep1Title}
        </h3>
        <p class="mt-2 text-base font-medium text-[var(--text-primary)] opacity-90">
          {t.howToStep1Text}
        </p>
      </article>

      <article class="rounded-2xl border-2 border-[#31AAA9] bg-[var(--bg-primary)] p-6">
        <div class="mb-3 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-[#31AAA9] font-display text-xl font-extrabold text-[#FFFFFF]">
          02
        </div>
        <h3 class="font-display text-xl font-extrabold text-[var(--text-primary)]">
          {t.howToStep2Title}
        </h3>
        <p class="mt-2 text-base font-medium text-[var(--text-primary)] opacity-90">
          {t.howToStep2Text}
        </p>
      </article>

      <article class="rounded-2xl border-2 border-[#31AAA9] bg-[var(--bg-primary)] p-6">
        <div class="mb-3 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-[#A82020] font-display text-xl font-extrabold text-[#FFFFFF]">
          03
        </div>
        <h3 class="font-display text-xl font-extrabold text-[var(--text-primary)]">
          {t.howToStep3Title}
        </h3>
        <p class="mt-2 text-base font-medium text-[var(--text-primary)] opacity-90">
          {t.howToStep3Text}
        </p>
      </article>
    </div>
  </section>

  <!-- 4 Core Technical Features Grid -->
  <section aria-labelledby="features-heading">
    <div class="mb-8 text-center">
      <h2
        id="features-heading"
        class="font-display text-3xl font-extrabold text-[var(--text-primary)] sm:text-4xl"
      >
        {t.featuresTitle}
      </h2>
      <p class="mt-2 text-lg font-medium text-[var(--text-secondary)]">
        {t.featuresSubtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <article
        class="rounded-3xl border-2 border-[#31AAA9] bg-[var(--bg-surface-card)] p-6 text-[var(--text-primary)] shadow-sm transition-transform hover:-translate-y-1"
      >
        <div
          class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-[#A82020] text-2xl text-[#FFFFFF] shadow-sm"
          aria-hidden="true"
        >
          🎨
        </div>
        <h3 class="font-display text-xl font-extrabold">{t.feat1Title}</h3>
        <p class="mt-2 text-base font-medium opacity-90">{t.feat1Desc}</p>
      </article>

      <article
        class="rounded-3xl border-2 border-[#31AAA9] bg-[var(--bg-surface-card)] p-6 text-[var(--text-primary)] shadow-sm transition-transform hover:-translate-y-1"
      >
        <div
          class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-[#31AAA9] text-2xl text-[#FFFFFF] shadow-sm"
          aria-hidden="true"
        >
          ✂️
        </div>
        <h3 class="font-display text-xl font-extrabold">{t.feat2Title}</h3>
        <p class="mt-2 text-base font-medium opacity-90">{t.feat2Desc}</p>
      </article>

      <article
        class="rounded-3xl border-2 border-[#31AAA9] bg-[var(--bg-surface-card)] p-6 text-[var(--text-primary)] shadow-sm transition-transform hover:-translate-y-1"
      >
        <div
          class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-[#A82020] text-2xl text-[#FFFFFF] shadow-sm"
          aria-hidden="true"
        >
          💬
        </div>
        <h3 class="font-display text-xl font-extrabold">{t.feat3Title}</h3>
        <p class="mt-2 text-base font-medium opacity-90">{t.feat3Desc}</p>
      </article>

      <article
        class="rounded-3xl border-2 border-[#31AAA9] bg-[var(--bg-surface-card)] p-6 text-[var(--text-primary)] shadow-sm transition-transform hover:-translate-y-1"
      >
        <div
          class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-[#31AAA9] text-2xl text-[#FFFFFF] shadow-sm"
          aria-hidden="true"
        >
          🔒
        </div>
        <h3 class="font-display text-xl font-extrabold">{t.feat4Title}</h3>
        <p class="mt-2 text-base font-medium opacity-90">{t.feat4Desc}</p>
      </article>
    </div>
  </section>

  <!-- FPS vs. Resolution vs. File Size Reference Table -->
  <section aria-labelledby="reference-table-heading">
    <div class="mb-6 text-center">
      <h2
        id="reference-table-heading"
        class="font-display text-3xl font-extrabold text-[var(--text-primary)] sm:text-4xl"
      >
        {t.tableTitle}
      </h2>
      <p class="mt-2 text-lg font-medium text-[var(--text-secondary)]">
        {t.tableSubtitle}
      </p>
    </div>

    <div class="overflow-x-auto rounded-3xl border-2 border-[#31AAA9] bg-[var(--workspace-box-bg)] shadow-sm">
      <table class="w-full min-w-[680px] border-collapse text-left text-sm sm:text-base">
        <thead>
          <tr class="border-b-2 border-[#31AAA9] bg-[#F8E0A4] text-[#6C1A1A] dark:bg-[#6C1A1A] dark:text-[#F8E0A4]">
            <th class="px-5 py-4 font-display font-extrabold">{t.tableColPreset}</th>
            <th class="px-5 py-4 font-display font-extrabold">{t.tableColFps}</th>
            <th class="px-5 py-4 font-display font-extrabold">{t.tableColWidth}</th>
            <th class="px-5 py-4 font-display font-extrabold">{t.tableColPalette}</th>
            <th class="px-5 py-4 font-display font-extrabold">{t.tableColSize}</th>
            <th class="px-5 py-4 font-display font-extrabold">{t.tableColBestFor}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#31AAA9]/30 font-medium">
          <tr class="hover:bg-[#F8E0A4]/20">
            <td class="px-5 py-3.5 font-extrabold text-[#A82020] dark:text-[#F8E0A4]">
              Discord / Sticker Maker
            </td>
            <td class="px-5 py-3.5 font-mono">10 – 15 FPS</td>
            <td class="px-5 py-3.5 font-mono">320px</td>
            <td class="px-5 py-3.5">192-Color Bayer Dither</td>
            <td class="px-5 py-3.5 font-mono font-bold text-[#31AAA9]">0.6 MB – 1.8 MB</td>
            <td class="px-5 py-3.5">Discord, Slack, Telegram Stickers</td>
          </tr>
          <tr class="hover:bg-[#F8E0A4]/20">
            <td class="px-5 py-3.5 font-extrabold text-[#A82020] dark:text-[#F8E0A4]">
              Balanced Social GIF
            </td>
            <td class="px-5 py-3.5 font-mono">15 FPS</td>
            <td class="px-5 py-3.5 font-mono">480px</td>
            <td class="px-5 py-3.5">256-Color 2-Pass Diff</td>
            <td class="px-5 py-3.5 font-mono font-bold text-[#31AAA9]">1.5 MB – 3.4 MB</td>
            <td class="px-5 py-3.5">Twitter / X, Reddit, Blog Embeds</td>
          </tr>
          <tr class="hover:bg-[#F8E0A4]/20">
            <td class="px-5 py-3.5 font-extrabold text-[#A82020] dark:text-[#F8E0A4]">
              HD Crisp 2-Pass Palette
            </td>
            <td class="px-5 py-3.5 font-mono">24 FPS</td>
            <td class="px-5 py-3.5 font-mono">640px</td>
            <td class="px-5 py-3.5">256-Color Sierra2_4a</td>
            <td class="px-5 py-3.5 font-mono font-bold text-[#31AAA9]">3.2 MB – 6.8 MB</td>
            <td class="px-5 py-3.5">GitHub Readmes, Product Demos, UI Clips</td>
          </tr>
          <tr class="hover:bg-[#F8E0A4]/20">
            <td class="px-5 py-3.5 font-extrabold text-[#A82020] dark:text-[#F8E0A4]">
              Ultra Cinema / Original
            </td>
            <td class="px-5 py-3.5 font-mono">30 FPS</td>
            <td class="px-5 py-3.5 font-mono">800px / Original</td>
            <td class="px-5 py-3.5">256-Color Full Stats</td>
            <td class="px-5 py-3.5 font-mono font-bold text-[#31AAA9]">6.5 MB – 12.0 MB</td>
            <td class="px-5 py-3.5">High-FPS Keyframe Art &amp; Portfolios</td>
          </tr>
          <tr class="hover:bg-[#F8E0A4]/20">
            <td class="px-5 py-3.5 font-extrabold text-[#A82020] dark:text-[#F8E0A4]">
              GIF to MP4 Reverse / Loop
            </td>
            <td class="px-5 py-3.5 font-mono">30 FPS</td>
            <td class="px-5 py-3.5 font-mono">Original HD</td>
            <td class="px-5 py-3.5">TrueColor YUV420p</td>
            <td class="px-5 py-3.5 font-mono font-bold text-[#31AAA9]">0.3 MB – 0.9 MB</td>
            <td class="px-5 py-3.5">Instagram, TikTok, Fast Web Video</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Keyword-Rich Semantic SEO Guide Cards -->
  <section aria-labelledby="seo-guide-heading" class="space-y-8">
    <div class="text-center">
      <h2
        id="seo-guide-heading"
        class="font-display text-3xl font-extrabold text-[var(--text-primary)] sm:text-4xl"
      >
        {t.seoGuideTitle}
      </h2>
      <p class="mt-2 text-lg font-medium text-[var(--text-secondary)]">
        {t.seoGuideSubtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      <article class="rounded-3xl border-2 border-[#31AAA9] bg-[var(--workspace-box-bg)] p-6 shadow-sm">
        <h3 class="font-display text-xl font-extrabold text-[#A82020] dark:text-[#F8E0A4]">
          🎬 {t.seoCard1Title}
        </h3>
        <p class="mt-3 text-base font-medium leading-relaxed text-[var(--text-primary)] opacity-90">
          {t.seoCard1Body}
        </p>
      </article>

      <article class="rounded-3xl border-2 border-[#31AAA9] bg-[var(--workspace-box-bg)] p-6 shadow-sm">
        <h3 class="font-display text-xl font-extrabold text-[#A82020] dark:text-[#F8E0A4]">
          ✨ {t.seoCard2Title}
        </h3>
        <p class="mt-3 text-base font-medium leading-relaxed text-[var(--text-primary)] opacity-90">
          {t.seoCard2Body}
        </p>
      </article>

      <article class="rounded-3xl border-2 border-[#31AAA9] bg-[var(--workspace-box-bg)] p-6 shadow-sm">
        <h3 class="font-display text-xl font-extrabold text-[#A82020] dark:text-[#F8E0A4]">
          💬 {t.seoCard3Title}
        </h3>
        <p class="mt-3 text-base font-medium leading-relaxed text-[var(--text-primary)] opacity-90">
          {t.seoCard3Body}
        </p>
      </article>

      <article class="rounded-3xl border-2 border-[#31AAA9] bg-[var(--workspace-box-bg)] p-6 shadow-sm">
        <h3 class="font-display text-xl font-extrabold text-[#A82020] dark:text-[#F8E0A4]">
          ⚡ {t.seoCard4Title}
        </h3>
        <p class="mt-3 text-base font-medium leading-relaxed text-[var(--text-primary)] opacity-90">
          {t.seoCard4Body}
        </p>
      </article>
    </div>
  </section>

  <!-- Translated SEO FAQ Section (Maps 1:1 to JSON-LD FAQPage) -->
  <section aria-labelledby="faq-heading" class="mx-auto max-w-4xl">
    <h2
      id="faq-heading"
      class="mb-8 text-center font-display text-3xl font-extrabold text-[var(--text-primary)] sm:text-4xl"
    >
      {t.faqTitle}
    </h2>

    <div class="space-y-4">
      {
        [
          { q: t.faq1Q, a: t.faq1A },
          { q: t.faq2Q, a: t.faq2A },
          { q: t.faq3Q, a: t.faq3A },
          { q: t.faq4Q, a: t.faq4A }
        ].map((item, idx) => (
          <details
            open={idx === 0}
            class="group rounded-2xl border-2 border-[#31AAA9] bg-[var(--workspace-box-bg)] p-5 shadow-sm transition-all"
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-extrabold text-[var(--text-primary)] sm:text-xl">
              <span>{item.q}</span>
              <span
                aria-hidden="true"
                class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-[#F8E0A4] text-[#6C1A1A] transition-transform group-open:rotate-180"
              >
                ▼
              </span>
            </summary>
            <p class="mt-3 border-t border-[#31AAA9]/30 pt-3 text-base font-medium text-[var(--text-primary)] opacity-90">
              {item.a}
            </p>
          </details>
        ))
      }
    </div>
  </section>
</div>

<!-- Footer -->
<footer class="border-t-2 border-[#31AAA9] bg-[var(--workspace-box-bg)] py-8">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 text-center sm:flex-row sm:text-left">
    <div>
      <p class="font-display text-lg font-extrabold text-[var(--text-primary)]">
        {t.brandName} — {t.brandTagline}
      </p>
      <p class="mt-1 text-sm font-bold text-[#31AAA9]">{t.footerPrivacyNote}</p>
    </div>
    <div class="flex flex-col items-center gap-2 sm:items-end">
      <a
        href="https://kisharadilshan.gumroad.com/coffee"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.navSupportDevAria}
        class="inline-flex items-center gap-2 rounded-xl border-2 border-[#6C1A1A] bg-[#A82020] px-4 py-2 text-sm font-extrabold text-[#FFFFFF] transition-colors hover:bg-[#6C1A1A]"
      >
        ☕ {t.navSupportDev}
      </a>
      <p class="text-xs font-semibold text-[var(--text-secondary)]">{t.footerCopyright}</p>
    </div>
  </div>
</footer>
